node_modules/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo

# Generated native projects (Continuous Native Generation)
mobile/ios/
mobile/android/
mobile/.expo/

# Lockfiles are generated — reformatting them fights the package manager
package-lock.json

# Regenerated by Next.js on every build, so formatting it is immediately undone
next-env.d.ts

# Translation data, not code.
#
# `locales/` is the source of truth and both apps hold a generated rsync copy
# (frontend/locales, mobile/locales). Reformatting the source would leave the
# tracked mobile copy differing until the next sync, for no readability gain on
# what is machine-consumed data. Left alone deliberately.
locales/
frontend/locales/
mobile/locales/

# Python is formatted by Ruff, not Prettier
*.py

