# Vector store selection: pgvector | qdrant | chroma
RAG_VECTOR_STORE=pgvector

# OpenAI embedding model
RAG_OPENAI_API_KEY=sk-...
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIM=3072

# pgvector — reuse the main app's PostgreSQL
RAG_PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/calmguide

# Qdrant (local or cloud)
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_API_KEY=
RAG_QDRANT_COLLECTION=calmguide_rag

# ChromaDB (local persistent)
RAG_CHROMA_PATH=./chroma_db
RAG_CHROMA_COLLECTION=calmguide_rag

# Scraping behaviour
RAG_SCRAPE_DELAY=1.5
RAG_MAX_CHUNK_TOKENS=400
RAG_CHUNK_OVERLAP_TOKENS=50
