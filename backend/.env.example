DATABASE_URL=postgresql+asyncpg://calmguide:calmguide@localhost:5432/calmguide
LLM_PROVIDER=openai
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MULTILINGUAL_MODEL=gpt-4o
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
CORS_ORIGINS=http://localhost:3000

# Encryption key for conversation content at rest (AES-256-GCM, 32-byte base64)
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
CONVERSATION_ENCRYPTION_KEY=

# Keyed hash for access/facility codes. Defeats offline dictionary attacks on
# the stored hashes. Falls back to CONVERSATION_ENCRYPTION_KEY when unset.
# NOTE: changing this invalidates every existing access and invite code —
# they are stored only as hashes and cannot be re-derived.
ACCESS_CODE_HMAC_SECRET=

# --- B2B / facility ---------------------------------------------------------
# REQUIRED for facility staff login. Without it, facility auth fails closed and
# the entire facility side of the app is non-functional (the server logs a
# warning at startup). Must be >= 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=900
# Guards admin-only endpoints. Leave unset to keep them unreachable.
ADMIN_API_KEY=

# --- Signup gating ----------------------------------------------------------
# Gate B2C signup behind a pre-generated shared invite code (private testing).
# Generate codes with: python scripts/generate_invite_codes.py --count 5
# Codes are shown once at generation and stored only as hashes.
INVITE_CODE_REQUIRED=true

# --- Read-aloud voice -------------------------------------------------------
# Neural text-to-speech. Off by default because it bills per character; when
# disabled the client falls back to the browser's built-in (robotic) voice, so
# read-aloud still works either way. Uses OPENAI_API_KEY.
TTS_ENABLED=false

# --- OpenMRS clinical context (optional) -------------------------------------
# Lets a caregiver link a Care Profile to an OpenMRS patient so the Moment
# Coach sees a short clinical summary on normal-risk messages. Off by default;
# emergency/high-risk messages never call OpenMRS. Use a dedicated read-only
# OpenMRS account (never admin). BASE_URL ends in /openmrs.
OPENMRS_ENABLED=false
OPENMRS_BASE_URL=
OPENMRS_USERNAME=
OPENMRS_PASSWORD=
OPENMRS_TIMEOUT_SECONDS=1.5
OPENMRS_CACHE_TTL_SECONDS=300

# --- Limits and tuning ------------------------------------------------------
# Per-IP rate limiting on the paid endpoints (LLM + speech). In-process only —
# each worker counts separately, so the effective limit is N x this value
# across N workers. Back with Redis before relying on it in production.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
LLM_TIMEOUT_SECONDS=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# Days to retain conversation data. Unset = retain indefinitely.
DATA_RETENTION_DAYS=

# RAG pipeline — Alzheimer's Association knowledge base (optional)
# Run `python -m rag.pipeline` from the repo root after setting these.
# NOTE: until this pipeline has been run there is no ingested content, and
# coach responses fall back to the model's own knowledge rather than retrieved
# source material.
RAG_VECTOR_STORE=pgvector
RAG_OPENAI_API_KEY=your-openai-key-here
RAG_PGVECTOR_DSN=postgresql://calmguide:calmguide@localhost:5432/calmguide
# RAG_QDRANT_URL=http://localhost:6333
# RAG_CHROMA_PATH=./chroma_db
